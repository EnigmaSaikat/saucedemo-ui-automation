# Java and Maven build output
target/
*.class
*.hprof
hs_err_pid*
replay_pid*

# Maven generated files and optional project-local dependency cache
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
buildNumber.properties
.flattened-pom.xml
/.mvn/timing.properties
/.m2/

# IntelliJ IDEA
.idea/
*.iml
*.ipr
*.iws
out/

# TestNG generated reports
test-output/
/testng-failed.xml

# Allure generated reports, runtime cache and local history
allure-results/
allure-report/
.allure/
.allure-history/
/history.jsonl

# Allure 3 CLI dependencies, if installed locally
node_modules/

# Generated Selenium artifacts (project root only)
/screenshots/
/videos/
/downloads/
/reports/
/test-artifacts/
/logs/
/*.log
/*.log.*
/.cache/selenium/
/node_modules
# Local environment files and personal overrides
.env
.env.*
!.env.example
!.env.sample
!.env.template
*.local.properties
/secrets/
/settings.xml
/settings-security.xml
package.json
package-lock.json
history.jsonl
# OS and editor temporary files
.DS_Store
Thumbs.db
[Dd]esktop.ini
*.swp
*.swo
*~

# Keep Maven Wrapper files, pom.xml, testng.xml, allure.properties,
# allurerc.*, .editorconfig and non-secret test resources trackable.
# No blanket *.jar, *.json, *.xml or *.png exclusions.